12:[["$","meta","0",{"charSet":"utf-8"}],["$","title","1",{"children":"আল-সাফওয়াহ ট্রাভেলস | নিশ্চিত হজ ও ওমরাহ ভিসা এবং এয়ার টিকিট সল্যুশন"}],["$","meta","2",{"name":"description","content":"ধর্ম বিষয়ক মন্ত্রণালয় ও সৌদি হজ মন্ত্রণালয় অনুমোদিত এজেন্সি (লাইসেন্স নং ১৪৩২)। নুসুক কোটায় নিশ্চিত হজ ও ওমরাহ ভিসা, সুলভ মূল্যে এয়ার টিকিট এবং হারামের নিকটবর্তী হোটেল সেবা।"}],["$","meta","3",{"name":"author","content":"আল-সাফওয়াহ ট্রাভেলস লিমিটেড"}],["$","meta","4",{"name":"keywords","content":"হজ এজেন্সি ঢাকা,ওমরাহ ভিসা বাংলাদেশ,নুসুক হজ কোটা,এয়ার টিকিট বুকিং,হজ প্যাকেজ ২০২৫,আইএটিএ ট্রাভেল এজেন্ট"}],["$","meta","5",{"property":"og:title","content":"আল-সাফওয়াহ ট্রাভেলস | নিশ্চিত হজ ও ওমরাহ ভিসা এবং এয়ার টিকিট সল্যুশন"}],["$","meta","6",{"property":"og:description","content":"ধর্ম বিষয়ক মন্ত্রণালয় ও সৌদি হজ মন্ত্রণালয় অনুমোদিত এজেন্সি। নুসুক কোটায় নিশ্চিত হজ ও ওমরাহ ভিসা এবং এয়ার টিকিট সমাধান।"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary"}],["$","meta","9",{"name":"twitter:title","content":"আল-সাফওয়াহ ট্রাভেলস | নিশ্চিত হজ ও ওমরাহ ভিসা এবং এয়ার টিকিট সল্যুশন"}],["$","meta","10",{"name":"twitter:description","content":"ধর্ম বিষয়ক মন্ত্রণালয় ও সৌদি হজ মন্ত্রণালয় অনুমোদিত এজেন্সি। নুসুক কোটায় নিশ্চিত হজ ও ওমরাহ ভিসা এবং এয়ার টিকিট সমাধান।"}]]
